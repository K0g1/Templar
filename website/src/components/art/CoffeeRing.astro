---
interface Props { class?: string }
const { class: className } = Astro.props;
---
<svg class={'art coffee-ring ' + (className ?? '')} viewBox="0 0 200 200" fill="none" aria-hidden="true">
  <defs>
    <radialGradient id="cr-r" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0.78" stop-color="#8a6a3e" stop-opacity="0"/><stop offset="0.88" stop-color="#8a6a3e" stop-opacity="0.4"/><stop offset="0.95" stop-color="#7c5d33" stop-opacity="0.24"/><stop offset="1" stop-color="#7c5d33" stop-opacity="0"/>
    </radialGradient>
    <filter id="cr-f" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0.08" numOctaves="3" seed="11" result="n"/>
      <feDisplacementMap in="SourceGraphic" in2="n" scale="6"/>
    </filter>
  </defs>
  <g filter="url(#cr-f)">
    <circle cx="100" cy="100" r="86" stroke="url(#cr-r)" stroke-width="16" fill="none"/>
    <path d="M94 176 C92 186 88 191 82 192 C76 191.4 73 187 73 180 C73 174 76 170 82 169 C87 168 91 171 94 176 Z" fill="#7c5d33" fill-opacity="0.3"/>
    <circle cx="58" cy="52" r="9" fill="#8a6a3e" fill-opacity="0.16"/>
  </g>
</svg>
