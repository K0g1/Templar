---
interface Props { class?: string }
const { class: className } = Astro.props;
---
<svg class={'art desk-clip ' + (className ?? '')} viewBox="0 0 160 190" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id="clip-brass" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#d8b877"/><stop offset="0.45" stop-color="#ab8544"/><stop offset="1" stop-color="#82622c"/>
    </linearGradient>
    <linearGradient id="clip-arm" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#8f8f91"/><stop offset="0.5" stop-color="#d6d6d8"/><stop offset="1" stop-color="#77777a"/>
    </linearGradient>
    <filter id="clip-shadow" x="-40%" y="-40%" width="180%" height="180%">
      <feDropShadow dx="0" dy="9" stdDeviation="10" flood-color="#221a10" flood-opacity="0.3"/>
    </filter>
  </defs>
  <g filter="url(#clip-shadow)">
    <!-- wire arms -->
    <path d="M30 168 C30 104 42 78 52 58 C60 44 66 34 64 24 C63 17 58 13 52 14 C44 16 40 22 38 30" stroke="url(#clip-arm)" stroke-width="7" stroke-linecap="round"/>
    <path d="M130 168 C130 104 118 78 108 58 C100 44 94 34 96 24 C97 17 102 13 108 14 C116 16 120 22 122 30" stroke="url(#clip-arm)" stroke-width="7" stroke-linecap="round"/>
    <!-- body -->
    <path d="M22 44 L138 44 L144 82 L16 82 Z" fill="url(#clip-brass)"/>
    <path d="M22 44 L138 44 L144 82 L16 82 Z" fill="none" stroke="#6d5122" stroke-width="1.4"/>
    <path d="M24 46 L136 46" stroke="#f2dcae" stroke-opacity="0.65" stroke-width="2"/>
    <path d="M27 70 L133 70 L136 78 L24 78 Z" fill="#6d5122" fill-opacity="0.4"/>
    <!-- hinge notches -->
    <g stroke="#6d5122" stroke-width="1.2" stroke-opacity="0.7">
      <line x1="38" y1="44" x2="38" y2="82"/><line x1="122" y1="44" x2="122" y2="82"/>
    </g>
    <circle cx="46" cy="63" r="2.6" fill="#f2dcae" fill-opacity="0.8"/>
    <circle cx="114" cy="63" r="2.6" fill="#f2dcae" fill-opacity="0.8"/>
  </g>
</svg>
