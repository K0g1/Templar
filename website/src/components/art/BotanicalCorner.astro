---
// Line-art fern + oak corner ornament.
interface Props { class?: string }
const { class: className } = Astro.props;
---
<svg class={'art botanical-corner ' + (className ?? '')} viewBox="0 0 420 420" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id="bot-ink" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#4a6740"/><stop offset="1" stop-color="#33492c"/>
    </linearGradient>
  </defs>
  <g stroke="url(#bot-ink)" fill="none">
    <!-- main fern stem -->
    <path d="M30 410 C60 320 74 240 118 128 C138 86 164 52 202 26" stroke-width="2.2" stroke-linecap="round"/>
    <!-- left fronds -->
    <g stroke-width="1.3">
      <path d="M64 344 C52 336 42 326 34 314 C28 306 28 300 34 296 C44 298 52 304 58 312"/>
      <path d="M74 306 C60 296 50 284 42 270 C36 262 36 254 42 248 C52 252 60 260 66 270"/>
      <path d="M84 268 C70 258 60 246 52 232 C46 224 46 216 52 210 C62 214 70 222 76 232"/>
      <path d="M94 230 C80 220 70 208 62 194 C56 186 56 178 62 172 C72 176 80 184 86 194"/>
      <path d="M104 192 C90 182 80 170 72 156 C66 148 66 140 72 134 C82 138 90 146 96 156"/>
      <path d="M114 154 C102 145 93 134 87 121 C82 113 82 106 87 101 C96 105 103 113 108 122"/>
      <path d="M124 118 C114 110 106 101 101 90 C97 82 97 76 101 71 C109 75 116 82 120 90"/>
      <path d="M134 84 C126 77 120 70 116 61 C113 55 113 49 116 45 C123 49 129 55 132 62"/>
    </g>
    <!-- right fronds (mirrored, shorter) -->
    <g stroke-width="1.3">
      <path d="M72 320 C86 312 96 302 104 290 C110 282 110 276 104 272 C94 274 86 280 80 288"/>
      <path d="M82 282 C96 274 106 264 114 252 C120 244 120 238 114 234 C104 236 96 242 90 250"/>
      <path d="M92 244 C106 236 116 226 124 214 C130 206 130 200 124 196 C114 198 106 204 100 212"/>
      <path d="M102 206 C114 199 123 190 130 179 C135 171 135 165 130 161 C121 164 114 169 109 177"/>
    </g>
    <!-- oak branch -->
    <path d="M30 410 C96 402 170 396 240 404 C290 408 350 402 396 382" stroke-width="2" stroke-linecap="round"/>
    <!-- oak leaves -->
    <g stroke-width="1.4" fill="rgba(74,103,64,0.08)">
      <path d="M112 398 C108 376 118 358 142 352 C150 366 148 384 138 396 C130 400 116 400 112 398 Z"/>
      <path d="M176 400 C172 378 182 360 206 354 C214 368 212 386 202 398 C194 402 180 402 176 400 Z"/>
      <path d="M240 400 C236 378 246 360 270 354 C278 368 276 386 266 398 C258 402 244 402 240 400 Z"/>
      <path d="M304 396 C300 374 310 356 334 350 C342 364 340 382 330 394 C322 398 308 398 304 396 Z"/>
      <path d="M368 388 C364 366 374 348 398 342 C406 356 404 374 394 386 C386 390 372 390 368 388 Z"/>
    </g>
    <!-- leaf veins -->
    <g stroke-width="0.9" stroke-opacity="0.7">
      <line x1="126" y1="386" x2="134" y2="364"/>
      <line x1="190" y1="388" x2="198" y2="366"/>
      <line x1="254" y1="388" x2="262" y2="366"/>
      <line x1="318" y1="384" x2="326" y2="362"/>
      <line x1="382" y1="376" x2="390" y2="354"/>
    </g>
    <!-- seed dots -->
    <g fill="#4a6740">
      <circle cx="98" cy="148" r="2.6"/><circle cx="136" cy="92" r="2.2"/><circle cx="160" cy="52" r="2"/><circle cx="196" cy="24" r="2.8"/>
    </g>
  </g>
</svg>
