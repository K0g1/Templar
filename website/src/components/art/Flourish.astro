---
// Swash underline flourish for headlines.
interface Props { class?: string }
const { class: className } = Astro.props;
---
<svg class={'art flourish ' + (className ?? '')} viewBox="0 0 340 28" fill="none" aria-hidden="true">
  <path d="M4 18 C60 4 120 2 168 10 C212 17 268 8 336 16" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
  <path d="M168 10 C174 18 180 22 188 23" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.7"/>
  <path d="M20 22 C40 26 58 26 72 22" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity="0.45"/>
  <circle cx="336" cy="16" r="2.6" fill="currentColor"/>
  <circle cx="4" cy="18" r="2.2" fill="currentColor" opacity="0.8"/>
</svg>
