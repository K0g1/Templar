---
// PageModeDemo — one shared sheet compiled by the plugin twice: pageless and
// paged, shown side by side. A slider narrows the paged pane to demonstrate
// that the whole sheet scales as one unit instead of reflowing.
import fieldGuide from '../data/field-guide.generated.json';
import { url } from '../lib/site';
const demo = fieldGuide.pageModeDemo;
const resolvedHtml = demo.html.replaceAll('src="field-guide/', 'src="' + url('/field-guide/'));
---
<div class="page-mode-demo paper-panel" data-page-demo>
  <div class="mode-toolbar">
    <div class="mode-switch" role="group" aria-label="Page mode view">
      <button type="button" class="active" data-mode="both" aria-pressed="true">Side by side</button>
      <button type="button" data-mode="pageless" aria-pressed="false">Pageless</button>
      <button type="button" data-mode="paged" aria-pressed="false">Paged</button>
    </div>
    <label class="mode-slider">Narrow pane
      <input type="range" min="45" max="100" value="92" data-pane-width aria-label="Narrow the paged pane" />
      <b data-pane-value>92%</b>
    </label>
  </div>
  <div class="mode-stages">
    <section class="mode-stage" data-stage="pageless">
      <header class="mode-stage-head">
        <strong>Pageless</strong>
        <p>Reflows like a normal note — lines re-wrap with the window.</p>
      </header>
      <div class="mode-sheet-area pageless-area">
        <div class="mode-sheet pageless" data-mode-sheet="pageless">
          <div class="live-note-scope" data-templar-scope={demo.pageless.scopeId}>
            <style is:inline set:html={demo.pageless.css}></style>
            <div class="templar-page"><div class="templar-page-content" set:html={resolvedHtml} /></div>
          </div>
        </div>
      </div>
    </section>
    <section class="mode-stage" data-stage="paged">
      <header class="mode-stage-head">
        <strong>Paged</strong>
        <p>Fixed A4 canvas — the whole sheet scales as one unit.</p>
      </header>
      <div class="mode-sheet-area paged-area">
        <div class="mode-sheet paged" data-mode-sheet="paged">
          <div class="live-note-scope" data-templar-scope={demo.paged.scopeId}>
            <style is:inline set:html={demo.paged.css}></style>
            <div class="templar-page"><div class="templar-page-content" set:html={resolvedHtml} /></div>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-page-demo]').forEach((demo) => {
    const stages = demo.querySelectorAll<HTMLElement>('[data-stage]');
    const buttons = demo.querySelectorAll<HTMLButtonElement>('[data-mode]');
    const range = demo.querySelector<HTMLInputElement>('[data-pane-width]');
    const valueLabel = demo.querySelector<HTMLElement>('[data-pane-value]');
    const pagedArea = demo.querySelector<HTMLElement>('.paged-area');

    const setMode = (mode: string) => {
      buttons.forEach((entry) => {
        const selected = entry.dataset.mode === mode;
        entry.classList.toggle('active', selected);
        entry.setAttribute('aria-pressed', String(selected));
      });
      stages.forEach((stage) => {
        const show = mode === 'both' || stage.dataset.stage === mode;
        stage.hidden = !show;
        stage.classList.toggle('solo', mode !== 'both');
      });
      fitPaged();
    };

    const fitPaged = () => {
      if (!pagedArea || !range) return;
      const width = pagedArea.clientWidth - 48;
      const height = pagedArea.clientHeight - 40;
      const fit = Math.min(width / 794, height / 1123);
      const scale = fit * (Number(range.value) / 100);
      demo.style.setProperty('--pane-scale', String(Math.max(0.18, scale)));
    };

    buttons.forEach((button) => button.addEventListener('click', () => setMode(button.dataset.mode || 'both')));
    range?.addEventListener('input', () => {
      if (valueLabel) valueLabel.textContent = range.value + '%';
      fitPaged();
    });
    window.addEventListener('resize', fitPaged);
    fitPaged();
  });
</script>
<style>
  .mode-stage.solo { grid-column: 1 / -1; }
  .mode-stage.solo .mode-sheet-area { max-width: 860px; margin-inline: auto; }
</style>
