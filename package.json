{
  "name": "templar",
  "version": "1.2.0-beta.1",
  "description": "Self-contained per-note visual page design for Obsidian.",
  "main": "main.js",
  "type": "module",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck:runtime && node esbuild.config.mjs production && npm run verify:mobile && npm run verify:privacy",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/*.integration.test.ts tests/*lifecycle.integration.test.ts",
    "bench": "vitest bench --run tests/performance.bench.ts tests/renderer-performance.bench.ts tests/page-renderer-performance.bench.ts",
    "bench:renderer": "vitest bench --run tests/renderer-performance.bench.ts tests/page-renderer-performance.bench.ts",
    "bench:stress": "TEMPLAR_BENCH_STRESS=1 vitest bench --run tests/page-renderer-performance.bench.ts",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "typecheck:runtime": "tsc -p tsconfig.runtime.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json --noEmit",
    "verify:mobile": "node scripts/verify-mobile-bundle.mjs",
    "verify:privacy": "node scripts/verify-runtime-policy.mjs",
    "verify:brat": "node scripts/verify-brat-release.mjs",
    "stage:release": "node scripts/stage-release.mjs",
    "verify:ship": "node scripts/verify-ship.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "check": "npm run lint && npm run typecheck:runtime && npm run typecheck:test && npm run typecheck:tooling && npm test && npm run build && npm run verify:privacy",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "markdown",
    "css",
    "notebook",
    "themes"
  ],
  "license": "MIT",
  "dependencies": {
    "@codemirror/view": "6.38.6",
    "postcss": "8.5.26",
    "postcss-selector-parser": "7.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "3.2.7",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-plugin-obsidianmd": "0.4.0",
    "globals": "17.9.0",
    "happy-dom": "20.11.2",
    "jiti": "2.6.1",
    "obsidian": "1.13.1",
    "semver": "7.7.2",
    "typescript": "5.8.3",
    "typescript-eslint": "8.59.1",
    "vitest": "3.2.7"
  }
}
